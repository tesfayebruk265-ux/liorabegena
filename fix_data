const newAutoAssign = `  // Auto-scan unassigned active enrollments on startup and when enrollments change
  // This ensures teacher assignment happens when an enrollment is activated
  // (e.g., after accountant verifies payment) not just when new enrollments are added.
  useEffect(() => {
    const unassignedActive = enrollments.filter(e =>
      e.status === 'Active' && (!e.assignedTeacherId || !e.assignedTeacherName || e.assignmentStatus === 'Pending Teacher Assignment')
    );
    if (unassignedActive.length > 0) {
      unassignedActive.forEach(e => {
        autoAssignTeacherForEnrollment(e.id);
      });
    }
